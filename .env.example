# Copie este arquivo para .env e preencha

# Chave de sessão, use um valor longo e aleatório
SECRET_KEY=coloque-uma-chave-longa-e-aleatoria

# Domínio institucional aceito no login
ALLOWED_DOMAIN=id.uff.br

# Acesso de teste sem Google. Deixe 1 para testar, 0 em produção
DEV_LOGIN=1

# Credenciais do Google OAuth. Deixe em branco enquanto testa
# Obtenha em https://console.cloud.google.com em Credenciais, ID do cliente OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
