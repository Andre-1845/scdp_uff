# Copie este arquivo para .env e preencha

# Chave de sessão, use um valor longo e aleatório
SECRET_KEY=coloque-uma-chave-longa-e-aleatoria

# Domínio institucional aceito no login
ALLOWED_DOMAIN=id.uff.br

# Acesso de teste sem Google. Deixe 1 para testar, 0 em produção
DEV_LOGIN=1

# Modo debug do Flask. Deixe 1 só no seu computador para testar; em
# QUALQUER ambiente acessível por outras pessoas, deixe 0 (ou nem defina),
# porque debug=1 mostra dados internos do sistema em caso de erro.
FLASK_DEBUG=0

# E-mails da Secretaria, separados por vírgula. Quem logar com um desses
# e-mails ganha acesso ao Painel da Secretaria (ve as solicitações de todos
# os professores, não só as próprias). Deixe em branco se ninguém for staff ainda.
STAFF_EMAILS=secretaria@id.uff.br

# Credenciais do Google OAuth. Deixe em branco enquanto testa
# Obtenha em https://console.cloud.google.com em Credenciais, ID do cliente OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
